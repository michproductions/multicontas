BRIDGE_SECRET=gere-um-segredo-longo-aleatorio
HOST=0.0.0.0
PORT=3000
# DATA_DIR precisa apontar para uma pasta persistente fora da versão publicada pela Hostinger.
# Exemplo ilustrativo; substitua pelo caminho persistente real fornecido pelo painel da sua hospedagem.
# DATA_DIR=/caminho/persistente/h2e-whatsapp-data
# SESSIONS_DIR=/caminho/persistente/h2e-whatsapp-data/sessions
DATA_DIR=./h2e-whatsapp-data
# Compatibilidade/migração de sessão única antiga (pode permanecer como estava na versão anterior).
AUTH_DIR=./auth_info
WORDPRESS_INBOUND_URL=https://seu-dominio.com/wp-json/h2e-crm/v1/bridge-incoming
LOG_LEVEL=warn
